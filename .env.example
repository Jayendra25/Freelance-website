# Public site URL — used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Enquiry delivery
# ---------------------------------------------------------------------------
# Option A — forward enquiries to any webhook (Zapier, Make, n8n, your own API).
# Receives a JSON POST with the enquiry and a submission reference.
ENQUIRY_WEBHOOK_URL=

# Option B — send enquiries by email through Resend (https://resend.com).
# RESEND_API_KEY is required. Enquiries are sent to ENQUIRY_TO_EMAIL, which
# defaults to the site contact address (code4kailash@gmail.com) if left blank.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=code4kailash@gmail.com
# Must be a verified sender/domain in Resend.
ENQUIRY_FROM_EMAIL=onboarding@resend.dev

# In development, if none of the above are set, enquiries are appended to
# .enquiries/enquiries.jsonl so the form can be tested end to end.
# In production the API returns 503 until a delivery method is configured.
